{
  "id": "sunsetphone-user-mod",
  "name": "SunsetPhone Mod",
  "version": "0.3.0",
  "type": "user-overlay",
  "entry": "index.html",
  "founderTest": {
    "enabled": true,
    "route": "#founder-test",
    "visibleToUsers": false
  },
  "capabilities": [
    "messages",
    "image-upload",
    "image-receive-test",
    "site-bridge",
    "realtime-sync",
    "gallery",
    "notifications",
    "official-iframe",
    "handshake"
  ],
  "storage": {
    "mode": "browser-cache",
    "backend": "official-site-bridge"
  }
}
